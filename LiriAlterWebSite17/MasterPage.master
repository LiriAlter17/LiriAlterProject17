<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <title>La17</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style>
        body {
    background-color: #f8f0f0;
    margin: 0;
    font-family: Arial, sans-serif;
}

.top-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    background-color: #2a0d0d;
    color: #f0e8e8;
    padding: 6px 16px;
    font-size: 13px;
    gap: 10px;
}

.top-bar .username {
    font-weight: 500;
    color: #d4b8b8;
}

.top-bar .logout-x {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    color: #e57373;
    font-size: 13px;
    font-weight: bold;
    transition: background 0.18s, color 0.18s;
    user-select: none;
}

.top-bar .logout-x:hover {
    background: #e57373;
    color: white;
}

.nav-bar {
    display: flex;
    flex-wrap: wrap;
    background: #ffffff;
    border-bottom: 1px solid #eedddd;
    padding: 0 8px;
}

.nav-bar a {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    font-size: 13px;
    color: #5c3a3a;
    text-decoration: none;
    border-radius: 6px;
    margin: 4px 2px;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
}

.nav-bar a img {
    height: 22px;
    width: auto;
    display: block;
    filter: opacity(0.75);
    transition: filter 0.15s;
}

.nav-bar a:hover {
    background: #faeeee;
    color: #8a1a1a;
}

.nav-bar a:hover img {
    filter: opacity(1);
}
    </style>
</head>
<body>

    <!-- Top info bar -->
    <div class="top-bar">
        <span class="logout-x" onclick="window.location='Exit.aspx'" title="Log out" style="<%= LogoutVisible %>">✕</span>
        <span class="username"><%= UserName %></span>
    </div>

    <!-- Navigation bar -->
    <nav class="nav-bar">
        <a href="HomePage.aspx">
            <img src="images/house-solid.png" alt="Home" /> Home Page</a>
        <a href="About.aspx">
            <img src="images/circle-info-solid.png" alt="About" /> About</a>
        <a href="Gallery.aspx">
            <img src="images/image-solid.png" alt="Gallery" /> Gallery</a>
        <a href="Register.aspx" style="<%= RegisterVisible %>">
            <img src="images/user-plus-solid.png" alt="Register" /> Register</a>
        <a href="Login.aspx" style="<%= LoginVisible %>">
            <img src="images/arrow-right-to-bracket-solid.png" alt="Login" /> Login</a>
        <a href="Manager.aspx" style="<%= ManagerVisible %>">
            <img src="images/user-tie-solid.png" alt="Manager" /> Manager</a>
        <a href="Search.aspx" style="<%= SearchVisible %>">
            <img src="images/magnifying-glass-solid.png" alt="Search" /> Search</a>
        <a href="Members.aspx" style="<%= MembersVisible %>">
            <img src="images/user-group-solid.png" alt="Members" /> Members</a>
        <a href="Fragrances.aspx" style="<%= FragrancesVisible %>">
            <img src="images/spray-can-solid.png" alt="Fragrances" /> Fragrances</a>
    </nav>

    <!-- Page content -->
    <table style="width: 100%" border="0">
        <tr>
            <td>
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </td>
        </tr>
    </table>

</body>
</html>