<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <title>La17</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style>
        body {
    background-color: #f0f4f8;
    margin: 0;
    font-family: Arial, sans-serif;
}

.top-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    background-color: #0d1b2a;
    color: #e8eaf0;
    padding: 6px 16px;
    font-size: 13px;
    gap: 10px;
}

.top-bar .username {
    font-weight: 500;
    color: #b8c4d4;
}

.top-bar .logout-x {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    color: #e57373;
    font-size: 13px;
    font-weight: bold;
    transition: background 0.18s, color 0.18s;
    user-select: none;
}

.top-bar .logout-x:hover {
    background: #e57373;
    color: white;
}

.nav-bar {
    display: flex;
    flex-wrap: wrap;
    background: #ffffff;
    border-bottom: 1px solid #dde3ee;
    padding: 0 8px;
}

.nav-bar a {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    font-size: 13px;
    color: #3a4a5c;
    text-decoration: none;
    border-radius: 6px;
    margin: 4px 2px;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
}

.nav-bar a img {
    height: 22px;
    width: auto;
    display: block;
    filter: opacity(0.75);
    transition: filter 0.15s;
}

.nav-bar a:hover {
    background: #eef3fa;
    color: #1a4a8a;
}

.nav-bar a:hover img {
    filter: opacity(1);
}
    </style>
</head>
<body>

    <!-- Top info bar -->
    <div class="top-bar">
        <span class="logout-x" onclick="window.location='Exit.aspx'" title="Log out" style="<%= LogoutVisible %>">✕</span>
        <span class="username"><%= UserName %></span>
    </div>

    <!-- Navigation bar -->
    <nav class="nav-bar">
        <a href="HomePage.aspx">
            <img src="images/HomePage.png" alt="Home" /></a>
        <a href="About.aspx">
            <img src="images/About.png" alt="About" /></a>
        <a href="Gallery.aspx">
            <img src="images/Gallery.png" alt="Gallery" /></a>
        <a href="Register.aspx" style="<%= RegisterVisible %>">
            <img src="images/Register.png" alt="Register" /></a>
        <a href="Login.aspx" style="<%= LoginVisible %>">
            <img src="images/Login.png" alt="Login" /></a>
        <a href="Manager.aspx" style="<%= ManagerVisible %>">
            <img src="images/Manager.png" alt="Manager" /></a>
        <a href="Search.aspx" style="<%= SearchVisible %>">
            <img src="images/Search.png" alt="Search" /></a>
        <a href="ComplexSearch.aspx" style="<%= ComplexSearchVisible %>">
            <img src="images/ComplexSearch.png" alt="Complex Search" /></a>
        <a href="SearchLike.aspx" style="<%= SearchLikeVisible %>">
            <img src="images/SearchLike.png" alt="Search Like" /></a>
        <a href="ComplexSearchLike.aspx" style="<%= ComplexSearchLikeVisible %>">
            <img src="images/ComplexSearchLike.png" alt="Complex Search Like" /></a>
        <a href="UpdateDetails.aspx" style="<%= UpdateDetailsVisible %>">
            <img src="images/UpdateDetails.png" alt="Update Details" /></a>
        <a href="Members.aspx" style="<%= MembersVisible %>">
            <img src="images/UpdateDetails.png" alt="Update Details" /></a>
    </nav>

    <!-- Page content -->
    <table style="width: 100%" border="0">
        <tr>
            <td>
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </td>
        </tr>
    </table>

</body>
</html>